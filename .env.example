OPENINC_PUSH_NODE_ENV=development
OPENINC_PUSH_PORT=3000
OPENINC_PUSH_MONGODB_URI=mongodb://localhost:27017
OPENINC_PUSH_MONGODB_DB_NAME=openinc_push
OPENINC_PUSH_MONGODB_COLLECTION_PREFIX=openinc_push_
OPENINC_PUSH_LOG_LEVEL=info
OPENINC_PUSH_API_KEY_SALT=replace-me
OPENINC_PUSH_DEFAULT_MAX_ATTEMPTS=5
